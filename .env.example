APP_NAME="Pick Me Retailers"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pickmeretailers
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === Trusted proxies (Cloudflare, production) ===
# Comma-separated CIDR ranges read via config('trustedproxy.proxies').
# See https://www.cloudflare.com/ips/ and deploy/README.md.
TRUSTED_PROXIES=

# === Shop settings ===
SHOP_NAME="Pick Me Retailers"
SHOP_BRANCH_PHONE="+639396152389"
SHOP_WAREHOUSE_PHONE="+639396152389"

# Same-day delivery dispatch window (half-open: start_hour up to end_hour).
SHOP_DISPATCH_START_HOUR=7
SHOP_DISPATCH_END_HOUR=15

# Quantity at or above which a cart line is charged the wholesale/resale price.
SHOP_BULK_PRICE_THRESHOLD=10

# Address that bulk-order inquiries are sent to.
RESELLER_INQUIRY_EMAIL=

# === Google (Maps + OAuth sign-in) ===
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
